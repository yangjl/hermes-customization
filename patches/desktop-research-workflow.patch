+  })
+
+  it('shares one cached request across repeated renders of the same identity', async () => {
+    render(
+      <>
+        <ProfileAvatar color={null} identity={makeIdentity()} />
+        <ProfileAvatar color={null} identity={makeIdentity()} />
+      </>
+    )
+    await flush()
+
+    expect(activeGatewayRequest).toHaveBeenCalledTimes(1)
+  })
+
+  it('is decorative by default and labelled only when asked', async () => {
+    const { container } = render(
+      <>
+        <ProfileAvatar color={null} identity={makeIdentity({ mayHaveAvatar: false })} />
