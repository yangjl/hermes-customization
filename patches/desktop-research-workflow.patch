@@ -0,0 +1,137 @@
+import { act, cleanup, fireEvent, render, waitFor } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import type { ProfileIdentity } from '@/lib/profile-identity'
+import { queryClient } from '@/lib/query-client'
+
+import { ProfileAvatar } from './profile-avatar'
+
+// The shared avatar tile: the stored `avatar` profile asset when the backend
+// has one, else the deterministic initial/color fallback. A broken image must
+// never appear — every failure path recovers to the fallback.
+
+const requestGatewayForAgent = vi.fn()
+
+vi.mock('@/store/gateway', () => ({
+  requestGatewayForAgent: (...args: unknown[]) => requestGatewayForAgent(...args)
+}))
+
+const DATA_URL = 'data:image/png;base64,QUJD'
+
+function makeIdentity(overrides: Partial<ProfileIdentity> = {}): ProfileIdentity {
+  return {
+    connectionId: 'pandora',
+    mayHaveAvatar: true,
+    hasMetadata: true,
+    initial: 'L',
+    key: 'pandora::scout',
+    nickname: 'Luna',
+    profile: 'scout',
+    ...overrides
+  }
+}
+
+const flush = () =>
+  act(async () => {
+    await Promise.resolve()
+    await Promise.resolve()
+  })
+
+const avatarImage = (container: HTMLElement) => container.querySelector<HTMLImageElement>('img')
+
+beforeEach(() => {
+  requestGatewayForAgent.mockResolvedValue({ found: true, data: DATA_URL })
+})
+
+afterEach(() => {
+  cleanup()
+  vi.clearAllMocks()
+  queryClient.clear()
+})
+
+describe('ProfileAvatar', () => {
+  it('renders the initial without calling the RPC when mayHaveAvatar is false', async () => {
+    const { container } = render(
+      <ProfileAvatar color="hsl(200 68% 58%)" identity={makeIdentity({ mayHaveAvatar: false })} />
+    )
+    await flush()
+
+    expect(requestGatewayForAgent).not.toHaveBeenCalled()
+    expect(avatarImage(container)).toBeNull()
+    expect(container.textContent).toBe('L')
+  })
+
+  it('renders the returned data URL when the asset is found', async () => {
+    const { container } = render(<ProfileAvatar color={null} identity={makeIdentity()} />)
+
+    await waitFor(() => expect(avatarImage(container)).toBeTruthy())
+    expect(avatarImage(container)?.getAttribute('src')).toBe(DATA_URL)
+  })
+
+  it('requests the asset from the exact source connection and profile', async () => {
+    render(<ProfileAvatar color={null} identity={makeIdentity()} />)
+    await flush()
+
+    expect(requestGatewayForAgent).toHaveBeenCalledWith('pandora', 'scout', 'profiles.get_asset', {
+      asset: 'avatar',
+      name: 'scout'
+    })
+  })
+
+  it('keeps the fallback when the asset is not found', async () => {
+    requestGatewayForAgent.mockResolvedValue({ found: false })
+    const { container } = render(<ProfileAvatar color={null} identity={makeIdentity()} />)
+    await flush()
+
+    expect(avatarImage(container)).toBeNull()
+    expect(container.textContent).toBe('L')
+  })
+
+  it('keeps the fallback when the request rejects', async () => {
+    requestGatewayForAgent.mockRejectedValue(new Error('gateway unreachable'))
+    const { container } = render(<ProfileAvatar color={null} identity={makeIdentity()} />)
+    await flush()
+
+    expect(avatarImage(container)).toBeNull()
+    expect(container.textContent).toBe('L')
+  })
+
+  it('recovers to the fallback when the image fails to load', async () => {
+    const { container } = render(<ProfileAvatar color={null} identity={makeIdentity()} />)
+
+    await waitFor(() => expect(avatarImage(container)).toBeTruthy())
+
+    fireEvent.error(avatarImage(container) as HTMLImageElement)
+
+    expect(avatarImage(container)).toBeNull()
+    expect(container.textContent).toBe('L')
+  })
+
+  it('shares one cached request across repeated renders of the same identity', async () => {
+    render(
+      <>
+        <ProfileAvatar color={null} identity={makeIdentity()} />
+        <ProfileAvatar color={null} identity={makeIdentity()} />
+      </>
+    )
+    await flush()
+
+    expect(requestGatewayForAgent).toHaveBeenCalledTimes(1)
+  })
+
+  it('is decorative by default and labelled only when asked', async () => {
+    const { container } = render(
+      <>
+        <ProfileAvatar color={null} identity={makeIdentity({ mayHaveAvatar: false })} />
+        <ProfileAvatar color={null} identity={makeIdentity({ mayHaveAvatar: false })} label="Luna's avatar" />
+      </>
+    )
+    await flush()
+
+    const tiles = container.querySelectorAll('[data-slot="profile-avatar"]')
+    expect(tiles[0].getAttribute('aria-hidden')).toBe('true')
+    expect(tiles[1].getAttribute('aria-hidden')).toBeNull()
+    expect(tiles[1].getAttribute('role')).toBe('img')
+    expect(tiles[1].getAttribute('aria-label')).toBe("Luna's avatar")
+  })
+})
diff --git a/apps/desktop/src/components/ui/profile-avatar.tsx b/apps/desktop/src/components/ui/profile-avatar.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..6eac87bb0eab30749a030dc5c9799fecf89f33e8
--- /dev/null
+++ b/apps/desktop/src/components/ui/profile-avatar.tsx
@@ -0,0 +1,101 @@
+import { useQuery } from '@tanstack/react-query'
+import { useState } from 'react'
+
+import type { ProfileIdentity } from '@/lib/profile-identity'
+import { profileColorSoft } from '@/lib/profile-color'
+import { queryClient } from '@/lib/query-client'
+import { cn } from '@/lib/utils'
+import { requestGatewayForAgent } from '@/store/gateway'
+
+// The one avatar tile every surface shares (profile rail squares, session
+// rows): the stored `avatar` profile asset when the backend reports one, else
+// the deterministic initial/color fallback. Every failure path — asset
+// missing, gateway unreachable, image decode error — recovers to the
+// fallback; a broken-image glyph must never appear.
+
+interface ProfileAssetResult {
+  found?: boolean
+  data?: string
+}
+
+// Bounded staleness so a newly edited avatar appears without relaunching
+// Hermes: cached per exact (connectionId, profile), refetched on focus once
+// the window has passed. Bot Mode remains the source of truth for edits.
+const AVATAR_STALE_MS = 60_000
+
+export function ProfileAvatar({
+  className,
+  color,
+  identity,
+  label,
+  tint = 22,
+  title
+}: {
+  className?: string
+  /** Resolved profile color (null → neutral, same as the rail squares). */
+  color: null | string
+  identity: ProfileIdentity
+  /** Accessible name. Omit when the surrounding button/row already carries
+   *  the label — the tile then stays decorative (aria-hidden). */
+  label?: string
+  /** Fallback tint strength, matching the rail's active/at-rest fills. */
+  tint?: number
+  /** Native hover tooltip — how a row surfaces the owner's nickname without
+   *  spending a second line of height on it. */
+  title?: string
+}) {
+  const [failedSrc, setFailedSrc] = useState<null | string>(null)
+
+  const { data } = useQuery(
+    {
+      enabled: identity.mayHaveAvatar,
+      queryFn: () =>
+        requestGatewayForAgent<ProfileAssetResult>(identity.connectionId, identity.profile, 'profiles.get_asset', {
+          asset: 'avatar',
+          name: identity.profile
+        }),
+      queryKey: ['profile-avatar', identity.key],
+      refetchOnWindowFocus: true,
+      retry: false,
+      staleTime: AVATAR_STALE_MS
+    },
+    // The shared client explicitly (not the context provider): non-provider
+    // hosts (tests, isolated surfaces) still hit the same per-identity cache,
+    // so N session rows for one profile issue one request.
+    queryClient
+  )
+
+  const src =
+    identity.mayHaveAvatar && data?.found && typeof data.data === 'string' && data.data && data.data !== failedSrc
+      ? data.data
+      : null
+
+  const hue = color ?? 'var(--ui-text-quaternary)'
+
+  return (
+    <span
+      aria-hidden={label ? undefined : true}
+      aria-label={label}
+      className={cn(
+        'relative grid shrink-0 select-none place-items-center overflow-hidden rounded-[3px] font-semibold uppercase leading-none',
+        className
+      )}
+      data-slot="profile-avatar"
+      role={label ? 'img' : undefined}
+      style={{ backgroundColor: profileColorSoft(hue, tint), color: color ?? undefined }}
+      title={title}
+    >
+      {src ? (
+        <img
+          alt=""
+          className="absolute inset-0 size-full object-cover"
+          draggable={false}
+          onError={() => setFailedSrc(src)}
+          src={src}
+        />
+      ) : (
+        identity.initial
+      )}
+    </span>
+  )
+}
diff --git a/apps/desktop/src/lib/profile-identity.test.ts b/apps/desktop/src/lib/profile-identity.test.ts
