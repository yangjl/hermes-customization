+export function foldProjectOverview(
+  projects: SidebarProjectTree[],
+  expanded: boolean,
+  limit = PROJECT_OVERVIEW_COUNT
+): { hiddenCount: number; projects: SidebarProjectTree[] } {
+  const homeOffset = projects[0]?.isNoProject ? 1 : 0
+  const hiddenCount = Math.max(0, projects.length - homeOffset - limit)
+
+  return {
+    hiddenCount,
+    projects: expanded || hiddenCount === 0 ? projects : projects.slice(0, homeOffset + limit)
+  }
+}
+
 // Project drill-in lanes are git-driven: source them from `git worktree list` so
 // linked worktrees still appear even when their sessions aren't in the recents
 // payload currently loaded in memory.
