index 0000000000000000000000000000000000000000..04e1bf8aa1dca6e82063cbcbe9b2062f77a33452
--- /dev/null
+++ b/apps/desktop/src/lib/profile-identity.ts
@@ -0,0 +1,104 @@
+import type { DesktopAgentRoster, DesktopRosterAgent, RosterProfileMetadata } from '@/global'
+
+// One profile identity for every surface that paints a profile (the rail and
+// the session rows): resolve the exact (connectionId, profile) row of the
+// fleet roster into a nickname, an avatar flag, and a deterministic fallback
+// initial. Pure — no store, no network — so both surfaces stay testable and
+// byte-identical.
+
+export interface ProfileIdentity {
+  connectionId: null | string
+  profile: string
+  /** Trimmed backend display_name, else the profile name. Never blank. */
+  nickname: string
+  /** True only when the backend reports a stored avatar asset. */
+  mayHaveAvatar: boolean
+  /** True when the roster carried metadata for this exact agent. */
+  hasMetadata: boolean
+  /** Stable source-qualified cache key for this exact (connection, profile). */
+  key: string
+  /** Deterministic single-character fallback (same rule as the rail squares). */
+  initial: string
+}
+
+/** Source-qualified key — never keyed by profile name alone (duplicate names
+ *  on two gateways must not share avatars or nicknames). */
+export function profileIdentityKey(connectionId: null | string, profile: string): string {
+  return `${connectionId ?? ''}::${profile}`
+}
+
+function fallbackInitial(name: string): string {
+  return name.replace(/[^a-z0-9]/gi, '').charAt(0) || '?'
+}
+
+function findRosterAgent(
+  roster: DesktopAgentRoster | null,
+  connectionId: null | string,
+  profile: string
+): DesktopRosterAgent | undefined {
+  if (!roster) {
+    return undefined
+  }
+
+  if (connectionId != null) {
+    return roster.agents.find(agent => agent.connectionId === connectionId && agent.profile === profile)
+  }
+
+  // Legacy rows (pre-registry sessions, single-gateway setups) carry no
+  // connection id. Only an unambiguous profile name can be attributed safely;
+  // duplicates across gateways stay on the fallback identity.
+  const matches = roster.agents.filter(agent => agent.profile === profile)
+
+  return matches.length === 1 ? matches[0] : undefined
+}
+
+/** Build an identity from metadata already in hand (a FleetAgent row).
+ *  `fallbackLabel` preserves an existing surface label (`profileLabel`) when
+ *  the metadata is absent, so the initial and nickname never regress. */
+export function profileIdentityFromMetadata({
+  connectionId,
+  fallbackLabel,
+  metadata,
+  profile
+}: {
+  connectionId: null | string
+  fallbackLabel?: string
+  metadata?: RosterProfileMetadata
+  profile: string
+}): ProfileIdentity {
+  const nickname = (metadata?.display_name ?? '').trim() || (fallbackLabel ?? '').trim() || profile.trim() || 'default'
+
+  return {
+    connectionId,
+    // Only an explicit `false` rules an avatar out. The desktop roster is built
+    // from REST `/api/profiles`, which omits `has_avatar` entirely (only the
+    // gateway RPC computes it), so treating "absent" as "no avatar" left every
+    // profile on its initial. Unknown means probe: `found: false` still falls
+    // back, and the asset query is cached per (connection, profile).
+    mayHaveAvatar: metadata?.has_avatar !== false,
+    hasMetadata: metadata != null,
+    initial: fallbackInitial(nickname),
+    key: profileIdentityKey(connectionId, profile),
+    nickname,
+    profile
+  }
+}
+
+export function resolveProfileIdentity({
+  connectionId,
+  fallbackLabel,
+  profile,
+  roster
+}: {
+  connectionId: null | string
+  fallbackLabel?: string
+  profile: string
+  roster: DesktopAgentRoster | null
+}): ProfileIdentity {
+  return profileIdentityFromMetadata({
+    connectionId,
+    fallbackLabel,
+    metadata: findRosterAgent(roster, connectionId, profile)?.profileMetadata,
+    profile
+  })
+}
