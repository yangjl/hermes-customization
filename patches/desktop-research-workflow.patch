+import { describe, expect, it } from 'vitest'
+
+import type { DesktopAgentRoster } from '@/global'
+
+import { profileIdentityKey, resolveProfileIdentity } from './profile-identity'
+
+// The pure identity resolver: roster metadata in, one stable profile identity
+// out. Everything the rail and session rows paint (nickname, avatar flag,
+// fallback initial) resolves here so both surfaces agree byte-for-byte.
+
+const roster: DesktopAgentRoster = {
+  agents: [
+    {
+      connectionId: 'local',
+      connectionKind: 'local',
+      connectionLabel: 'This device',
+      profile: 'scout',
+      handle: 'scout-local',
+      profileMetadata: { display_name: 'Luna', has_avatar: true }
+    },
+    {
+      connectionId: 'pandora',
+      connectionKind: 'remote',
+      connectionLabel: 'Pandora',
+      profile: 'scout',
+      handle: 'scout-pandora',
+      profileMetadata: { display_name: 'Pandora Scout', has_avatar: false }
+    },
+    {
+      connectionId: 'local',
+      connectionKind: 'local',
+      connectionLabel: 'This device',
+      profile: 'plain',
+      handle: 'plain'
+      // No metadata: an old gateway that only enumerates names.
+    },
+    {
+      connectionId: 'local',
+      connectionKind: 'local',
+      connectionLabel: 'This device',
+      profile: 'blankname',
+      handle: 'blankname',
+      profileMetadata: { display_name: '   ', has_avatar: true }
+    }
+  ],
+  sources: [
+    { connectionId: 'local', kind: 'local', label: 'This device', reachable: true },
+    { connectionId: 'pandora', kind: 'remote', label: 'Pandora', reachable: true }
+  ]
+}
+
+describe('resolveProfileIdentity', () => {
+  it('matches by exact (connectionId, profile), keeping duplicate names source-correct', () => {
+    const local = resolveProfileIdentity({ connectionId: 'local', profile: 'scout', roster })
+    const pandora = resolveProfileIdentity({ connectionId: 'pandora', profile: 'scout', roster })
+
+    expect(local.nickname).toBe('Luna')
+    expect(local.mayHaveAvatar).toBe(true)
+    expect(pandora.nickname).toBe('Pandora Scout')
+    expect(pandora.mayHaveAvatar).toBe(false)
+    expect(local.key).not.toBe(pandora.key)
+  })
+
+  it('uses the trimmed display_name as the nickname', () => {
+    const identity = resolveProfileIdentity({
+      connectionId: 'local',
+      profile: 'scout',
+      roster: {
+        ...roster,
+        agents: [{ ...roster.agents[0], profileMetadata: { display_name: '  Luna  ', has_avatar: true } }]
+      }
+    })
+
+    expect(identity.nickname).toBe('Luna')
+  })
+
+  it('falls back to the profile name when display_name is blank or missing', () => {
+    expect(resolveProfileIdentity({ connectionId: 'local', profile: 'blankname', roster }).nickname).toBe('blankname')
+    expect(resolveProfileIdentity({ connectionId: 'local', profile: 'plain', roster }).nickname).toBe('plain')
+  })
+
+  it('rules an avatar out only when the backend says so explicitly', () => {
+    expect(resolveProfileIdentity({ connectionId: 'local', profile: 'blankname', roster }).mayHaveAvatar).toBe(true)
+    expect(resolveProfileIdentity({ connectionId: 'pandora', profile: 'scout', roster }).mayHaveAvatar).toBe(false)
+  })
+
+  // REST `/api/profiles` — the roster's actual source — omits `has_avatar`
+  // entirely, so "absent" must mean "probe it", not "no avatar". Treating the
+  // two alike left every real profile stuck on its initial.
+  it('probes when the roster carries no has_avatar flag', () => {
+    expect(resolveProfileIdentity({ connectionId: 'local', profile: 'plain', roster }).mayHaveAvatar).toBe(true)
+
+    const noFlag = {
+      ...roster,
+      agents: [{ ...roster.agents[0], profileMetadata: { display_name: 'Luna' } }]
+    }
+
+    expect(resolveProfileIdentity({ connectionId: 'local', profile: roster.agents[0].profile, roster: noFlag }).mayHaveAvatar).toBe(true)
+  })
+
+  it('flags whether the roster carried metadata at all', () => {
+    expect(resolveProfileIdentity({ connectionId: 'local', profile: 'scout', roster }).hasMetadata).toBe(true)
+    expect(resolveProfileIdentity({ connectionId: 'local', profile: 'plain', roster }).hasMetadata).toBe(false)
+  })
+
+  it('returns a usable fallback identity without a roster', () => {
+    const identity = resolveProfileIdentity({ connectionId: null, profile: 'scout', roster: null })
+
+    expect(identity.nickname).toBe('scout')
+    expect(identity.mayHaveAvatar).toBe(true)
+    expect(identity.hasMetadata).toBe(false)
+    expect(identity.initial).toBe('s')
+  })
+
+  it('attributes a null connection id only to an unambiguous profile name', () => {
+    // "scout" lives on two gateways: no safe owner, stay on the fallback.
+    expect(resolveProfileIdentity({ connectionId: null, profile: 'scout', roster }).hasMetadata).toBe(false)
+    // "blankname" exists once: a legacy row without a connection id is its.
+    expect(resolveProfileIdentity({ connectionId: null, profile: 'blankname', roster }).mayHaveAvatar).toBe(true)
+  })
+
+  it('derives the fallback initial from the nickname', () => {
+    expect(resolveProfileIdentity({ connectionId: 'local', profile: 'scout', roster }).initial).toBe('L')
+    expect(resolveProfileIdentity({ connectionId: 'local', profile: '--!', roster: null }).initial).toBe('?')
+  })
+
+  it('never returns a blank nickname', () => {
+    expect(resolveProfileIdentity({ connectionId: null, profile: '', roster: null }).nickname).toBe('default')
+  })
+
+  it('builds a stable source-qualified key', () => {
+    expect(profileIdentityKey('local', 'scout')).toBe('local::scout')
+    expect(profileIdentityKey(null, 'scout')).toBe('::scout')
+  })
+})
diff --git a/apps/desktop/src/lib/profile-identity.ts b/apps/desktop/src/lib/profile-identity.ts
