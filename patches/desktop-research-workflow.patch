+import { describe, expect, it } from 'vitest'
+
+import { contextUsagePercent } from './statusbar'
+
+describe('contextUsagePercent', () => {
+  it('returns a rounded, bounded percentage when context capacity is known', () => {
+    expect(contextUsagePercent({ calls: 0, context_max: 100, context_percent: 41.4, input: 0, output: 0, total: 0 })).toBe(41)
+    expect(contextUsagePercent({ calls: 0, context_max: 100, context_percent: 140, input: 0, output: 0, total: 0 })).toBe(100)
+  })
+
+  it('returns null before the backend reports a context capacity', () => {
+    expect(contextUsagePercent({ calls: 0, input: 0, output: 0, total: 20 })).toBeNull()
+  })
+})
