index 000000000..8a0b26470
--- /dev/null
+++ b/apps/desktop/src/app/hooks/use-on-profile-switch.test.tsx
@@ -0,0 +1,40 @@
+import { act, cleanup, render } from '@testing-library/react'
+import { StrictMode } from 'react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { $activeGatewayProfile } from '@/store/profile'
+
+import { useOnProfileSwitch } from './use-on-profile-switch'
+
+function Harness({ onSwitch }: { onSwitch: () => void }) {
+  useOnProfileSwitch(onSwitch)
+
+  return null
+}
+
+describe('useOnProfileSwitch', () => {
+  beforeEach(() => {
+    $activeGatewayProfile.set('default')
+  })
+
+  afterEach(() => {
+    cleanup()
+    $activeGatewayProfile.set('default')
+  })
+
+  it('does not report the StrictMode effect replay as a profile switch', () => {
+    const onSwitch = vi.fn()
+
+    render(
+      <StrictMode>
+        <Harness onSwitch={onSwitch} />
+      </StrictMode>
+    )
+
+    expect(onSwitch).not.toHaveBeenCalled()
+
+    act(() => $activeGatewayProfile.set('research'))
+
+    expect(onSwitch).toHaveBeenCalledOnce()
+  })
+})
diff --git a/apps/desktop/src/components/ui/context-usage-ring.tsx b/apps/desktop/src/components/ui/context-usage-ring.tsx
new file mode 100644
index 000000000..703aa7bad
--- /dev/null
+++ b/apps/desktop/src/components/ui/context-usage-ring.tsx
@@ -0,0 +1,30 @@
+import type { ComponentProps } from 'react'
+
+import { cn } from '@/lib/utils'
+
+interface ContextUsageRingProps extends Omit<ComponentProps<'svg'>, 'children'> {
+  percent: number
+}
+
+/** Compact occupancy ring shared by the composer and status bar. */
+export function ContextUsageRing({ className, percent, ...props }: ContextUsageRingProps) {
+  const bounded = Math.max(0, Math.min(100, Math.round(percent)))
+
+  return (
+    <svg aria-hidden className={cn('size-3', className)} viewBox="0 0 12 12" {...props}>
+      <circle cx="6" cy="6" fill="none" opacity="0.18" r="4.5" stroke="currentColor" strokeWidth="1.5" />
+      <circle
+        cx="6"
+        cy="6"
+        fill="none"
+        pathLength="100"
+        r="4.5"
+        stroke="currentColor"
+        strokeDasharray={`${bounded} 100`}
+        strokeLinecap="round"
+        strokeWidth="1.5"
+        transform="rotate(-90 6 6)"
+      />
+    </svg>
+  )
+}
