@@ -0,0 +1,30 @@
+import type { ComponentProps } from 'react'
+
+import { cn } from '@/lib/utils'
+
+interface ContextUsageRingProps extends Omit<ComponentProps<'svg'>, 'children'> {
+  percent: number
+}
+
+/** Compact occupancy ring shared by the composer and status bar. */
+export function ContextUsageRing({ className, percent, ...props }: ContextUsageRingProps) {
+  const bounded = Math.max(0, Math.min(100, Math.round(percent)))
+
+  return (
+    <svg aria-hidden className={cn('size-3', className)} viewBox="0 0 12 12" {...props}>
+      <circle cx="6" cy="6" fill="none" opacity="0.18" r="4.5" stroke="currentColor" strokeWidth="1.5" />
+      <circle
+        cx="6"
+        cy="6"
+        fill="none"
+        pathLength="100"
+        r="4.5"
+        stroke="currentColor"
+        strokeDasharray={`${bounded} 100`}
+        strokeLinecap="round"
+        strokeWidth="1.5"
+        transform="rotate(-90 6 6)"
+      />
+    </svg>
+  )
+}
